{
  "name": "watchling-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Bridges Claude Code / Codex events to Watchling, a desk robot on the ESP-VoCat (EchoEar) board",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/bridge.js",
    "dev": "tsx src/bridge.ts",
    "list-ports": "tsx src/list-ports.ts",
    "bridge:start": "node dist/start-bridge.js",
    "bridge:status": "node dist/bridge-status.js",
    "bridge:stop":"node dist/stop-bridge.js",
    "hooks:install": "node dist/install-hooks.js install",
    "hooks:uninstall": "node dist/install-hooks.js uninstall",
    "hooks:install:codex": "node dist/install-hooks.js install --codex",
    "hooks:uninstall:codex": "node dist/install-hooks.js uninstall --codex",
    "voice:design": "tsx src/voice/generate-voice.ts design",
    "voice:audition": "tsx src/voice/generate-voice.ts audition",
    "voice:generate": "tsx src/voice/generate-voice.ts generate"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
