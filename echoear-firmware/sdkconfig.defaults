# ESP-VoCat V1.2 — ESP32-S3-WROOM-1-N16R16V (16MB QIO flash, 16MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Octal PSRAM. Large allocations go to PSRAM; keep internal RAM for DMA, LVGL draw
# buffers and the ESP-SR AFE.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Run code/rodata from PSRAM so flash writes don't stall LCD refresh
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Caches sized for ESP-SR + LVGL
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Console on the built-in USB-Serial-JTAG (same port used for flashing and the bridge link)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_BUILD_EXAMPLES=n

# Bluetooth LE link to pc-bridge (main/ble_link.c): NimBLE peripheral, one bonded host.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
# LESC only: legacy pairing has no protection against a passive eavesdropper.
# CONFIG_BT_NIMBLE_SM_LEGACY is not set
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Keep internal RAM for DMA and LVGL; the host's buffers live in PSRAM.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# One advertiser + one connection; fewer controller activities means less internal RAM.
CONFIG_BT_CTRL_BLE_MAX_ACT=3

# LVGL draw buffers are DMA-capable internal RAM (2 x 360 x 60 x 2 B = 84 KB). The BSP default
# of 100 lines no longer fits next to the BT controller; the dashboard mostly redraws small areas.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=60
